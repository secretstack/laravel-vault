{
    "name": "ibid/laravel-vault",
    "description": "Centralized HashiCorp Vault secret management for IBID Laravel services.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "vault", "hashicorp", "secrets", "ibid"],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/console": "^9.0 || ^10.0 || ^11.0",
        "illuminate/contracts": "^9.0 || ^10.0 || ^11.0",
        "illuminate/encryption": "^9.0 || ^10.0 || ^11.0",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0",
        "guzzlehttp/guzzle": "^7.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0 || ^9.0",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ibid\\Vault\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ibid\\Vault\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ibid\\Vault\\VaultServiceProvider"
            ],
            "aliases": {
                "Vault": "Ibid\\Vault\\Facades\\Vault"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
